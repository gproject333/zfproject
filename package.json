{
  "name": "smart-zuj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm --filter @smart-zuj/convex run deploy && pnpm --filter @smart-zuj/web build",
    "start": "pnpm --filter @smart-zuj/web start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
